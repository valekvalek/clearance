# Шаблон переменных окружения InvixAI (Clearance AI). Скопируйте этот файл в
# .env и впишите значения — .env рядом с app.py подхватывается автоматически
# при старте (python app.py / uvicorn app:app), экспортировать переменные
# руками не нужно. .env не попадает в Docker-образ (см. .dockerignore) — для
# Docker его нужно либо передать через -e, либо смонтировать в контейнер.

# === Обязательно для обработки инвойсов ===
# Какой провайдер ИИ использовать: yandex (основной, по умолчанию) или gemini
# (резервный — оставлен на случай, если понадобится вернуться без правок кода).
AI_PROVIDER=yandex

# --- Yandex Cloud AI Studio (основной провайдер) ---
# Ключ и ID каталога (folder) берутся в консоли:
# https://aistudio.yandex.ru/platform/folders/<ваш_folder_id>
# Без ключа сервис работает (вход, история результатов), а обработка файла
# сразу даёт ошибку «Не задан ключ Yandex AI Studio».
YANDEX_API_KEY=
YANDEX_FOLDER_ID=

# --- Google AI Studio (Gemini) — резервный провайдер ---
# Нужен только если AI_PROVIDER=gemini. https://aistudio.google.com/apikey
GEMINI_API_KEY=

# === Первый администратор (нужно один раз, при пустой базе) ===
# Логин и пароль, под которыми создастся первая учётка-админ. Если оставить
# пустым — админ создастся с логином admin и случайным паролем, который
# будет один раз записан в data/initial_admin_password.txt.
ADMIN_USER=
ADMIN_PASSWORD=

# === Том с данными ===
# Куда писать базу (app.db), ключи, результаты обработки и т.п. На сервере
# должен указывать на постоянный (persistent) том, не на временную папку.
# Без этой переменной сервис попробует /data, а если он недоступен — попадёт
# во временную app/data и выдаст предупреждение в лог.
DATA_DIR=/data

# Порт, на котором слушает сервис.
PORT=8000

# === После переезда на свой домен ===
# Свой домен сервиса — нужен для защиты от CSRF (см. ПЛАН_ДОРАБОТКИ.md, 1.11).
# Пример: ALLOWED_ORIGINS=https://invix.example.com
ALLOWED_ORIGINS=

# === Необязательно — лимиты и модели (можно не трогать, есть разумные значения по умолчанию) ===
# Модель Yandex для чата/перевода (без префикса gpt://<folder_id>/ — он
# добавляется кодом сам). Пример для vision/скан-PDF — отдельная модель,
# т.к. обычная yandexgpt изображения не принимает.
# AI_MODEL=yandexgpt/latest
# EXTRACT_MODEL=yandexgpt/latest
# YANDEX_VISION_MODEL=qwen3.6-35b-a3b
# Запасные модели Yandex, если основная упёрлась в лимит/квоту или недоступна (через запятую):
# YANDEX_MODEL_FALLBACKS=yandexgpt-lite/latest
#
# Модели Gemini (используются только при AI_PROVIDER=gemini):
# AI_MODEL=gemini-3.8-flash
# EXTRACT_MODEL=gemini-3.8-flash
# GEMINI_MODEL_FALLBACKS=gemini-flash-latest,gemini-3.1-flash-lite,gemini-2.5-flash
#
# OXYLABS_USER=
# OXYLABS_PASS=
# MAX_UPLOAD_FILES=5
# MAX_UPLOAD_MB=40
# MAX_UNZIPPED_MB=300
# MAX_PDF_PAGES=50
# JOB_WORKERS=3
# YANDEX_MAX_CONCURRENT=10
# GEMINI_MAX_CONCURRENT=10
# JOB_TIME_LIMIT=1800
# CACHE_TTL_DAYS=90  # срок жизни кеша поиска/фото по товару (дней)

# === Разовый принудительный сброс пароля админа (см. README) ===
# ADMIN_RESET_TOKEN=
